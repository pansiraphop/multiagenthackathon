# InstaCook — copy to .env and fill in.  `cp .env.example .env`
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Supabase / Postgres  (Project Settings -> Database -> Connection string)
# ---------------------------------------------------------------------------
# Shape:  postgresql://postgres.<project-ref>:<PASSWORD>@<host>.pooler.supabase.com:<PORT>/postgres
#   PORT 6543 = pooled / "Transaction pooler" (pgBouncer)  -> DATABASE_URL
#   PORT 5432 = direct / "Session pooler" or "Direct"      -> DIRECT_URL
# Prisma needs BOTH: it talks over DATABASE_URL, but `prisma db push` runs DDL,
# which cannot go through pgBouncer, so it uses DIRECT_URL.
# URL-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase REST — this is what the Python app actually uses (supabase-py)
# Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
# service_role key: bypasses RLS. Server-side scripts only, never ship to a browser.
SUPABASE_SERVICE_KEY=""

# ---------------------------------------------------------------------------
# Anthropic — extraction (stage 1) and score_reason (stage 3)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Google Calendar — stages 2 and 6 (read + write)
# Request the single scope https://www.googleapis.com/auth/calendar
# (calendar.events alone 403s on free/busy reads).
# Both paths are gitignored; GOOGLE_TOKEN_PATH is written on first consent.
# ---------------------------------------------------------------------------
GOOGLE_CREDENTIALS_PATH="credentials.json"
GOOGLE_TOKEN_PATH="token.json"
GOOGLE_CALENDAR_ID="primary"
# IANA name, e.g. America/Los_Angeles. Every Calendar write sends it explicitly.
TIMEZONE="America/Los_Angeles"

# ---------------------------------------------------------------------------
# Instacart — stage 5, tier 1 (Developer Platform shopping-list endpoint)
# ---------------------------------------------------------------------------
INSTACART_API_KEY=""
INSTACART_API_BASE="https://connect.instacart.com"

# ---------------------------------------------------------------------------
# Browserbase — stage 5, tier 2 (drive a real Instacart session)
# ---------------------------------------------------------------------------
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Stage 7 (optional) — voice cook session. Calendar descriptions link to
# {APP_BASE_URL}/cook/{meal_plan.id} from the very first version.
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:8000"
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""

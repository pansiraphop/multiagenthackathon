# InstaCook — copy to .env and fill in. Never commit real keys.

# ---------------------------------------------------------------------------
# Supabase REST — what the Python app uses (supabase-py).
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
# The key the Python client reads. Publishable key works for full read+write
# right now because RLS is disabled on all 9 tables (see README / DATABASE.md).
SUPABASE_KEY="sb_publishable_..."
# Optional today. Only needed if RLS gets enabled — then fill this in
# (Project Settings -> API -> service_role) and point SUPABASE_KEY at it.
SUPABASE_SERVICE_KEY=""

# ---------------------------------------------------------------------------
# Postgres direct connection — ONLY needed for `npm run db:push`.
# The schema is already applied, so you can ignore these unless you change it.
# Project Settings -> Database -> Connection string. Fill password + region.
# URL-encode special chars in the password (@ -> %40, # -> %23).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Anthropic — extraction (stage 1) and score_reason (stage 3)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Instagram webhook ingestion — caption first, local Whisper best-effort.
# ---------------------------------------------------------------------------
META_VERIFY_TOKEN="replace-with-a-random-verification-token"
# Public tunnel for Meta's Instagram webhook. Update whenever ngrok restarts.
NGROK_URL="https://your-subdomain.ngrok-free.dev"
WEBHOOK_URL="https://your-subdomain.ngrok-free.dev/webhook"
INGEST_TRANSCRIBE="true"
WHISPER_MODEL="base"

# ---------------------------------------------------------------------------
# Instagram DM replies — stage 5b (the loop back to the user)
# Without a token the agent prints its question and resolves the week itself,
# so this is optional. With one, it asks and waits for a reply.
# Token: Meta app -> Instagram -> API setup with Instagram login -> generate
# a token for the professional account the reels are sent to. Needs
# instagram_business_manage_messages.
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_API_BASE="https://graph.instagram.com"
INSTAGRAM_API_VERSION="v23.0"
# Your Instagram-scoped id, used only for seeded reels that carry no sender.
# The webhook logs the real one on the first reel you send.
INSTAGRAM_DM_RECIPIENT=""
INSTAGRAM_DM_TIMEOUT_SECONDS="20"

# ---------------------------------------------------------------------------
# Google Calendar — stages 2 and 6 (read + write)
# Request the single scope https://www.googleapis.com/auth/calendar
# (calendar.events alone 403s on free/busy reads).
# ---------------------------------------------------------------------------
GOOGLE_CREDENTIALS_PATH="credentials.json"
GOOGLE_TOKEN_PATH="token.json"
GOOGLE_CALENDAR_ID="primary"
TIMEZONE="America/Los_Angeles"

# ---------------------------------------------------------------------------
# Instacart via Browserbase — stage 5
# Log in once with scripts/instacart_probe.py, then save the printed context id.
# ---------------------------------------------------------------------------
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""
BROWSERBASE_CONTEXT_ID=""
BROWSERBASE_SESSION_TIMEOUT_SECONDS="1800"
INSTACART_ZIP=""
# Instacart store slug confirmed by the probe, e.g. "safeway".
INSTACART_RETAILER=""

# ---------------------------------------------------------------------------
# Stage 7 (optional) — ElevenLabs voiceover and voice cook session
# The key must be the secret itself (starts with "sk_"), not the key ID shown
# in the dashboard list, and it needs the text_to_speech permission.
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:8000"
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
# A voice id, or a name: sarah, george, brian. These three work on a free
# account; the classic premade voices (Rachel, Aria) are library voices and
# return HTTP 402 without a paid plan.
ELEVENLABS_VOICE="EXAVITQu4vr4xnSDxMaL"
ELEVENLABS_MODEL="eleven_multilingual_v2"
VOICEOVER_DIR="out/voiceover"

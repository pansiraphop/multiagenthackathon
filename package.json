{
  "name": "instacook-schema",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma schema (source of truth) for the InstaCook Supabase database. Schema only - the app queries via supabase-py.",
  "scripts": {
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "sql:generate": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > sql/schema.sql",
    "db:validate": "prisma validate"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
